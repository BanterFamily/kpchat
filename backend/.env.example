# ---- Database ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="kpchat_database"

# ---- Auth / JWT ----
# WAJIB diganti untuk produksi: openssl rand -hex 32
JWT_SECRET="ganti-dengan-random-hex-64-karakter"
JWT_EXPIRE_MINUTES="43200"

# ---- OTP ----
# true  = kode OTP dikembalikan di response API (dev_code) untuk testing
# false = WAJIB di produksi (OTP hanya via SMS)
ALLOW_DEV_OTP="true"

# ---- CORS ----
# Kosong = permisif (dev). Produksi: isi daftar origin dipisah koma.
ALLOWED_ORIGINS=""

# ---- Object Storage (upload media) ----
EMERGENT_LLM_KEY=""
INTEGRATION_PROXY_URL="https://integrations.emergentagent.com"

# ---- Twilio SMS (opsional) ----
# Kosongkan untuk tetap di mode dev OTP.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
